# À définir dans Netlify > Project configuration > Environment variables.
# Les secrets ont le scope Functions, jamais VITE_ (les variables VITE_ sont publiques).
TTS_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Facultatifs selon le fournisseur choisi.
DEEPINFRA_API_KEY=
DEEPINFRA_TEXT_MODEL=meta-llama/Llama-3.3-70B-Instruct
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3

# Seulement pour l'ancien serveur local Express.
PORT=8787
HOST=127.0.0.1
