# LivreVox fonctionne sans Google AI Studio.
# Choisis un fournisseur TTS via l'interface ou avec ces variables côté serveur.
TTS_PROVIDER=deepinfra

# DeepInfra / Kokoro
DEEPINFRA_API_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Amazon Polly
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3

# Modèle texte DeepInfra utilisé pour les résumés si DeepInfra est sélectionné.
DEEPINFRA_TEXT_MODEL=meta-llama/Llama-3.3-70B-Instruct

PORT=8787
HOST=127.0.0.1
