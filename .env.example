# Copie ce fichier en .env pour le mode local.
# Ne commit jamais ta vraie clé API.
GEMINI_API_KEY=

# Modèle rapide et économique recommandé pour LivreVox.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# Voix Gemini par défaut.
GEMINI_TTS_VOICE=Kore

# Serveur local LivreVox.
PORT=8787
HOST=127.0.0.1
